flowchart LR
    customers@{ shape: icon, icon: "lucide:user-round", label: "Customers", form: "rounded", h: 48 }
    mobile_application@{ shape: icon, icon: "lucide:app-window", label: "Mobile Application", form: "rounded", h: 48 }
    order_api@{ shape: icon, icon: "lucide:server", label: "Order API", form: "rounded", h: 48 }
    order_processing_service@{ shape: icon, icon: "lucide:server", label: "Order Processing Service", form: "rounded", h: 48 }
    relational_database@{ shape: icon, icon: "lucide:database", label: "Relational Database", form: "rounded", h: 48 }
    message_broker@{ shape: icon, icon: "lucide:messages-square", label: "Message Broker", form: "rounded", h: 48 }
    inventory_service@{ shape: icon, icon: "lucide:server", label: "Inventory Service", form: "rounded", h: 48 }
    external_warehouse_system@{ shape: icon, icon: "lucide:monitor", label: "External Warehouse System", form: "rounded", h: 48 }

    customers -->|Places orders| mobile_application
    mobile_application -->|Order requests| order_api
    order_api -->|Valid orders| order_processing_service
    order_processing_service -->|Stores order data| relational_database
    order_processing_service -->|Publishes OrderCreated event| message_broker
    message_broker -->|OrderCreated event| inventory_service
    inventory_service --> external_warehouse_system

    classDef type_actor fill:#eef2ff,stroke:#4f46e5,stroke-width:1.5px,color:#1e1b4b;
    classDef type_application fill:#eff6ff,stroke:#2563eb,stroke-width:1.5px,color:#172554;
    classDef type_service fill:#ecfdf5,stroke:#059669,stroke-width:1.5px,color:#064e3b;
    classDef type_gateway fill:#fff7ed,stroke:#d97706,stroke-width:1.5px,color:#78350f;
    classDef type_database fill:#f0fdfa,stroke:#0f766e,stroke-width:1.5px,color:#134e4a;
    classDef type_external_system fill:#f8fafc,stroke:#64748b,stroke-width:1.5px,color:#0f172a;
    classDef type_message_broker fill:#faf5ff,stroke:#7e22ce,stroke-width:1.5px,color:#581c87;
    class customers type_actor;
    class mobile_application type_application;
    class order_api,order_processing_service,inventory_service type_service;
    class relational_database type_database;
    class external_warehouse_system type_external_system;
    class message_broker type_message_broker;
