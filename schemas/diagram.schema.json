{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:requirement-to-diagram:diagram-schema:1",
  "title": "Structured Diagram",
  "description": "The source model for a diagram. Unique IDs, group membership, nesting depth, and edge references are checked by the Python model.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "diagram_type", "direction", "nodes", "edges"],
  "properties": {
    "title": { "$ref": "#/$defs/text" },
    "diagram_type": { "enum": ["architecture", "flowchart"] },
    "direction": { "enum": ["LR", "RL", "TB", "BT"] },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/node_id" },
        "label": { "$ref": "#/$defs/text" },
        "parent_group": { "$ref": "#/$defs/node_id" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/node_id" },
        "label": { "$ref": "#/$defs/text" },
        "group": { "$ref": "#/$defs/node_id" },
        "icon": { "$ref": "#/$defs/text" },
        "type": {
          "enum": [
            "actor",
            "application",
            "service",
            "gateway",
            "database",
            "message_broker",
            "external_system"
          ]
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": { "$ref": "#/$defs/node_id" },
        "target": { "$ref": "#/$defs/node_id" },
        "label": { "$ref": "#/$defs/text" },
        "protocol": { "$ref": "#/$defs/text" }
      }
    }
  }
}
